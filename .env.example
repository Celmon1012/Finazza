# Copy to apps/api/.env to override defaults.
# The database target is Supabase. Until the SQL in apps/api/supabase/schema.sql
# has been applied and SUPABASE_SECRET_KEY is set, the API keeps an embedded
# MongoDB in apps/api/data so the app can still run.

PORT=4000
NODE_ENV=development
MONGODB_URI=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Optional. When unset, password-reset links are printed in the API log
# and returned to the client in development.
RESEND_API_KEY=
EMAIL_FROM=FINAZZA <noreply@finazza.app>

# Optional production file storage. When unset, files are stored on disk.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
